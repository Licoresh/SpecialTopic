# Copy this file to .env and fill in values from the Supabase project settings.
# Use only the publishable key. Never put a secret/service_role key here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# For public Docker hosting, replace this with a DNS name pointing to the server.
APP_DOMAIN=localhost
