FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY requirements.txt requirements-suggestions.txt ./
RUN pip install --no-cache-dir --root-user-action=ignore \
    -r requirements.txt -r requirements-suggestions.txt
COPY . .
EXPOSE 80
CMD ["sh", "-c", "exec python -m streamlit run app.py --server.address=0.0.0.0 --server.port=${PORT:-80} --server.headless=true"]
